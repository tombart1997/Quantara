# Copy this file to .env and adjust as needed. .env is gitignored.

# --- Database ---
# Docker Compose Postgres (default). For a quick start without Docker,
# temporarily use: DATABASE_URL=sqlite:///./dev.db
POSTGRES_USER=investor
POSTGRES_PASSWORD=investor
POSTGRES_DB=investing_dashboard
DATABASE_URL=postgresql+psycopg://investor:investor@localhost:5432/investing_dashboard

# --- Backend ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API (Angular dev server).
CORS_ORIGINS=http://localhost:4200

# --- Market data provider ---
# "yfinance" = real Yahoo Finance data (no API key). "mock" = deterministic fake data.
MARKET_DATA_PROVIDER=mock

# --- AI consultant (optional) ---
# Without a key the app returns a data-grounded prompt to paste into any AI chat.
# With a key it calls Kimi directly (OpenAI-compatible chat completions).
# Kimi Code plan key:  base URL https://api.kimi.com/coding/v1, model kimi-for-coding
# Kimi Platform key:   base URL https://api.moonshot.cn/v1,     model e.g. kimi-k2-0711-preview
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-for-coding
